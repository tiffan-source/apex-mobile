{
  "name": "apex-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Apex sur iOS et Android : mener un objectif jusqu'au sommet, pas après pas.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routes:types": "expo customize tsconfig.json",
    "typecheck": "npm run -s routes:types && tsc --noEmit",
    "test": "jest",
    "verifier": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "export": "expo export --platform ios --platform android",
    "api:types": "npx --yes openapi-typescript@7.13.0 openapi/apex-brain.openapi.json -o src/infrastructure/apex-brain/schema.d.ts && prettier --write src/infrastructure/apex-brain/schema.d.ts"
  },
  "dependencies": {
    "@empreinte-studio/noyau": "^0.3.1",
    "@empreinte-studio/react-native": "^0.3.1",
    "@empreinte-studio/tokens": "^0.3.1",
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "marked": "^18.1.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.20",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
